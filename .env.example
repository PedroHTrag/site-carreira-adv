# GEMINI_API_KEY: Opcional caso utilize integracoes futuras no servidor.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL publica da aplicacao em producao (usada em URLs canonicas e sitemap).
APP_URL="MY_APP_URL"

# VITE_GA4_MEASUREMENT_ID: ID de medicao do Google Analytics 4 (ex: G-XXXXXXXXXX).
VITE_GA4_MEASUREMENT_ID=""

# VITE_GSC_VERIFICATION: Codigo de verificacao do Google Search Console (meta google-site-verification).
VITE_GSC_VERIFICATION=""
